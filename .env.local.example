# Copy this file to .env.local and fill in your own credentials.
# Never commit .env.local or expose these values in client-side code.

# Market data: Tencent public API (qt.gtimg.cn), no token required.
# News: Sina Finance 7x24 live JSON API (zhibo.sina.com.cn), no token required.
#
# AI: 任何 OpenAI 兼容的端点都可使用，下面以 DeepSeek 为例：
#   - DeepSeek:    AI_BASE_URL=https://api.deepseek.com           AI_MODEL=deepseek-v4-flash
#   - 通义千问:    AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   AI_MODEL=qwen-plus
#   - 智谱 GLM:    AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4   AI_MODEL=glm-4-flash
#   - Moonshot:    AI_BASE_URL=https://api.moonshot.cn/v1            AI_MODEL=moonshot-v1-8k
#   - SiliconFlow: AI_BASE_URL=https://api.siliconflow.cn/v1         AI_MODEL=Qwen/Qwen2.5-7B-Instruct
#   - OpenAI:      AI_BASE_URL=https://api.openai.com/v1             AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_TEMPERATURE=0.2
